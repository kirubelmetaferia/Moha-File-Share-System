DATABASE_URL="mysql://appuser:apppassword@mysql:3306/moha_file_share"
JWT_SECRET="your-super-secret-jwt-key"
PORT=5000

# Email Configuration
EMAIL_ENABLED=false
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="noreply@moha.local"
EMAIL_FROM_NAME="Moha File Share"
FRONTEND_URL="http://localhost:5173"

# Editor Config (OnlyOffice)
ONLYOFFICE_DOC_SERVER="http://localhost:8080"
ONLYOFFICE_JWT_SECRET="dev_onlyoffice_secret_key"
CALLBACK_URL_BASE="http://host.docker.internal:5000"

# Cloud Import (Google Drive)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:5000/api/cloud/google/callback"
